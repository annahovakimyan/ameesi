# Copy to .env (git-ignored) and fill in from Supabase: Project Settings → API keys.
# Both values are public by design. Never put the secret key here or anywhere in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
# Uncomment to see placeholder texts instead of Supabase content (useful before entries are approved).
# EXPO_PUBLIC_CONTENT_SOURCE=placeholder
# Calculation server (default https://ameesi.onrender.com). For a local server: http://10.0.2.2:8000 on the Android emulator, or your computer's address on a phone.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000
